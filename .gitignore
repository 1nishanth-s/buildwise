# --- Local Databases & User History (Fresh DB auto-initialized by app) ---
data/*.db
data/*.sqlite3
data/buildwise_projects.db
data/e2e_test_projects.db
*.db
*.sqlite3

# --- Environment Files & Secrets ---
.env
.env.local
.env.*.local
