# =============================================================================
# BuildWise-AI — Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# Note: Defaults work out-of-the-box for local Windows execution.
# =============================================================================

# Backend Server Host and Port
BUILDWISE_HOST=127.0.0.1
BUILDWISE_PORT=8000

# SQLite Persistence Database Path (default: data/buildwise_projects.db)
# BUILDWISE_DB_PATH=data/buildwise_projects.db

# Frontend API Base URL (default: /api proxied via Vite dev server or FastAPI)
# VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Optional custom Python executable path for Playwright E2E test runner
# PYTHON_PATH=.venv/Scripts/python.exe
